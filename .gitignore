# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large 3D asset files - NEVER commit these
*.gltf
*.obj
*.mtl
*.fbx
*.blend

# Raw data files - process locally, don't commit
data/raw/**
!data/raw/.gitkeep

# Processed data - large binary files
data/processed/glb/**
!data/processed/glb/.gitkeep

# Keep metadata files (JSON/text)
!data/processed/metadata/
